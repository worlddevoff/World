# Copy to .env / use `vercel env pull` after linking.
# NEVER commit real keys.

# Token mint (CA) — $RollerCT on pump.fun (also set TOKEN_MINT on Vercel)
VITE_TOKEN_MINT=2wNSnBhniBHorWTUcSTaTe65JBgYt2w5zcnAWou8pump

# Server-only PumpPortal key (Vercel / local .env — NEVER use VITE_ prefix)
# Linked wallet must hold ≥ 0.02 SOL
# PUMPPORTAL_API_KEY=

# Optional server mint override (defaults to VITE_TOKEN_MINT)
# TOKEN_MINT=

# Neon / Postgres — provisioned by: vercel integration add neon
# DATABASE_URL=

# Optional SOL/USD fallback (default 150)
# VITE_SOL_USD=150

# Optional fixed organism seed for shared brain
# EXPERIMENT_SEED=

# AI Gateway thought model (default openai/gpt-5-mini)
# EXPERIMENT_THOUGHT_MODEL=openai/gpt-5-mini

# Dev / sim tools + force_* actions (header: x-experiment-dev-secret)
# EXPERIMENT_DEV_SECRET=

# Optional separate secret for automation market posts (header: x-experiment-ingest-secret)
# EXPERIMENT_INGEST_SECRET=

# Allow ?force=1 on /api/think when also authorized (dev secret or cron)
# ALLOW_FORCE_THINK=1

# Required for Vercel Cron calls to /api/think (Authorization: Bearer …)
# CRON_SECRET=
