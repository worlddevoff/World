# Copy to .env for local dev. NEVER commit .env or real keys.
# On Vercel: Project → Settings → Environment Variables (Production).

# Token mint (CA) — defaults to $WORLD if unset
VITE_TOKEN_MINT=4WZAZkbsG7nETtYEJD2cf1uGdv2zXCNghuPXZJcZpump

# PumpPortal API key — set in hosting env only, not in source
# Linked wallet must hold ≥ 0.02 SOL
VITE_PUMPPORTAL_API_KEY=

# Optional SOL/USD fallback (default 150)
# VITE_SOL_USD=150
